function featBlock(list,i,extraCls){
  const f=list[i];
  const box=el("div","feat"+(extraCls?" "+extraCls:""));
  if(f._ed){
    const n=el("input","tx"); n.value=f.n; n.placeholder="Nome"; n.oninput=()=>f.n=n.value; box.appendChild(n);
    const t=el("textarea"); t.value=f.t; t.placeholder="Texto"; t.oninput=()=>f.t=t.value; box.appendChild(t);
    const bts=el("div","bts");
    const ok=el("button","ok","✓ salvar"); ok.onclick=()=>{delete f._ed;ch();};
    const rm=el("button","rm","✕ remover"); rm.onclick=()=>{list.splice(i,1);ch();};
    bts.appendChild(ok); bts.appendChild(rm); box.appendChild(bts);
  } else {
    box.appendChild(el("b",null,esc(f.n)));
    box.appendChild(el("p",null,esc(f.t)));
    const ed=el("button","ed","✎"); ed.title="editar"; ed.onclick=()=>{f._ed=true;render();}; box.appendChild(ed);
  }
  return box;
}
function featList(parent,titulo,list,extraCls){
  parent.appendChild(el("label","fl",titulo));
  list.forEach((f,i)=>parent.appendChild(featBlock(list,i,extraCls)));
  const a=el("button","add","+ adicionar"); a.onclick=()=>{list.push({n:"",t:"",_ed:true});render();}; parent.appendChild(a);
}

/* ============ RENDER ============ */
function render(){
  const tabs=document.getElementById("tabs"); tabs.innerHTML="";
  PJ.forEach((p,i)=>{
    const t=el("div","tab"+(i===cur?" sel":""),"<b>"+esc(p.nome)+"</b><span>"+esc(p.classe)+" · nv "+p.nivel+"</span>");
    const hp=el("div","hp"); hp.style.width=(100*Math.min(1,p.pv/(p.pvMax||1)))+"%"; t.appendChild(hp);
    t.onclick=()=>{cur=i;lsSet(KEY+"_cur",String(i));REST={tipo:null,mv:[],log:""};DICE.last=null;render();window.scrollTo({top:0});};
    tabs.appendChild(t);
  });
