const DB={on:false,ref:null,status:"local",ultimo:{},timers:{},pendente:false};
function dbStatus(s){ DB.status=s; const e=document.getElementById("dbst"); if(e){ e.textContent=({local:"◌ salvo só neste navegador",conectando:"… conectando ao banco",online:"☁ sincronizado com o banco",offline:"⚠ banco fora do ar — salvando local"})[s]||s; e.className="dbst "+s; } }
function dbInit(){
  if(!DB_CONFIG.databaseURL || !window.firebase){ dbStatus("local"); return; }
  try{
    firebase.initializeApp(DB_CONFIG);
    DB.ref=firebase.database().ref("mesas/"+MESA);
    DB.on=true; dbStatus("conectando");
    // primeira carga: banco manda; se o banco estiver vazio, sobe o que há no navegador
    DB.ref.child("fichas").once("value").then(snap=>{
      const remoto=snap.val();
      if(remoto && Object.keys(remoto).length){
        PJ=Object.values(remoto).map(normaliza);
        DB.ref.child("ordem").once("value").then(o=>{ const ord=o.val()||[]; PJ.sort((a,b)=>{ const ia=ord.indexOf(a.id), ib=ord.indexOf(b.id); return (ia<0?999:ia)-(ib<0?999:ib); }); PJ.forEach(p=>DB.ultimo[p.id]=JSON.stringify(limpo(p))); PJ.forEach(saveOneLocal); saveIndexLocal(); if(cur>=PJ.length)cur=0; render(); });
      } else {
        PJ.forEach(p=>DB.ref.child("fichas/"+p.id).set(limpo(p)));
        DB.ref.child("ordem").set(PJ.map(p=>p.id));
      }
      dbStatus("online");
      // escuta mudanças de outros jogadores
      DB.ref.child("fichas").on("value",s=>{
        const r=s.val()||{}; let mudou=false;
        Object.keys(r).forEach(id=>{ const j=JSON.stringify(normaliza(r[id])); if(DB.ultimo[id]!==j){ DB.ultimo[id]=j; const i=PJ.findIndex(p=>p.id===id); const nova=normaliza(JSON.parse(j)); if(i>=0){ Object.keys(PJ[i]).forEach(k=>{ if(k[0]==="_") nova[k]=PJ[i][k]; }); PJ[i]=nova; } else PJ.push(nova); saveOneLocal(nova); mudou=true; } });
        PJ.forEach((p,i)=>{ if(!r[p.id] && DB.ultimo[p.id]!==undefined){ PJ.splice(i,1); lsDel(KEY_FICHA(p.id)); delete DB.ultimo[p.id]; mudou=true; } });
        if(mudou){ if(cur>=PJ.length)cur=Math.max(0,PJ.length-1); saveIndexLocal(); const a=document.activeElement; if(a&&(a.tagName==="INPUT"||a.tagName==="TEXTAREA"||a.isContentEditable)){ DB.pendente=true; } else render(); }
      });
      DB.ref.child("ordem").on("value",o=>{ const ord=o.val(); if(!Array.isArray(ord))return; PJ.sort((a,b)=>{ const ia=ord.indexOf(a.id), ib=ord.indexOf(b.id); return (ia<0?999:ia)-(ib<0?999:ib); }); });
      firebase.database().ref(".info/connected").on("value",s=>dbStatus(s.val()?"online":"offline"));
    }).catch(e=>{ console.error(e); dbStatus("offline"); });
  }catch(e){ console.error(e); dbStatus("local"); }
}
document.addEventListener("focusout",()=>{ if(DB.pendente){ DB.pendente=false; setTimeout(render,50); } });
function dbSave(p){
  if(!DB.on) return;
  const j=JSON.stringify(limpo(p)); DB.ultimo[p.id]=j;
  clearTimeout(DB.timers[p.id]);
  DB.timers[p.id]=setTimeout(()=>{ DB.ref.child("fichas/"+p.id).set(JSON.parse(j)).catch(()=>dbStatus("offline")); },250);
}
function dbIndex(){ if(DB.on) DB.ref.child("ordem").set(PJ.map(p=>p.id)); }
function dbRemove(id){ if(DB.on){ delete DB.ultimo[id]; DB.ref.child("fichas/"+id).remove(); dbIndex(); } }

/* ============ PERSISTÊNCIA (uma chave por ficha) ============ */
const KEY_IDX=KEY+"_idx";           // ordem das abas: ["dahlia","baine",...]
const KEY_FICHA=id=>KEY+"_ficha_"+id;
let MEM={};
function lsGet(k){ try{return localStorage.getItem(k);}catch(e){return MEM[k]??null;} }
function lsSet(k,v){ MEM[k]=v; try{localStorage.setItem(k,v);}catch(e){} }
function lsDel(k){ delete MEM[k]; try{localStorage.removeItem(k);}catch(e){} }
function limpo(o){ return JSON.parse(JSON.stringify(o,(k,v)=>(k[0]==="_")?undefined:v)); }
function saveOneLocal(p){ lsSet(KEY_FICHA(p.id),JSON.stringify(limpo(p))); }
function saveIndexLocal(){ lsSet(KEY_IDX,JSON.stringify(PJ.map(p=>p.id))); }
function saveOne(p){ saveOneLocal(p); dbSave(p); }
function saveIndex(){ saveIndexLocal(); dbIndex(); }
function saveAll(){ PJ.forEach(saveOne); saveIndex(); }
function normaliza(p){ if(p.pv==null)p.pv=0; if(p.fad==null)p.fad=0; if(p.esp==null)p.esp=2; if(p.arm==null)p.arm=0; if(!p.bolsa)p.bolsa=[]; if(!p.recursos)p.recursos=[]; if(p.notas==null)p.notas=[]; if(typeof p.notas==="string") p.notas=p.notas.trim()?[{titulo:"Anotações",texto:p.notas,data:new Date().toISOString().slice(0,10)}]:[]; if(!p.transFeats)p.transFeats=[]; if(!p.cartas)p.cartas=[]; if(!p.armaRes)p.armaRes="Nenhuma"; if(!p.experiencias)p.experiencias=[]; p.cartas.forEach(c=>{ if(c.mao==null)c.mao=true; }); if(typeof p.dominios==="string") p.dominios=p.dominios.split("&").map(s=>s.trim()); return p; }
let PJ=[];
(function carregar(){
  let idx=null; try{ idx=JSON.parse(lsGet(KEY_IDX)||"null"); }catch(e){}
  if(!idx){
    // migração da versão antiga (tudo numa chave só)
    let velho=null; try{ velho=JSON.parse(lsGet(KEY)||"null"); }catch(e){}
    if(Array.isArray(velho)){ velho.forEach(p=>{ if(!p.id)p.id="pj_"+Math.random().toString(36).slice(2,8); }); PJ=velho; lsDel(KEY); }
    else PJ=JSON.parse(JSON.stringify(BASE));
    PJ.forEach(normaliza); saveAll(); return;
  }
  idx.forEach(id=>{ try{ const r=lsGet(KEY_FICHA(id)); if(r) PJ.push(normaliza(JSON.parse(r))); }catch(e){} });
  // fichas oficiais novas que ainda não existem neste navegador
  BASE.forEach(b=>{ if(!PJ.some(p=>p.id===b.id) && !idx.includes(b.id)){ PJ.push(normaliza(JSON.parse(JSON.stringify(b)))); saveOne(PJ[PJ.length-1]); } });
  saveIndex();
})();
let cur=0;
