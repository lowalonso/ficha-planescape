/* ============ REPOUSO ============ */
let REST={tipo:null,mv:[],log:""};
function aplicarRepouso(p){
  if(REST.mv.length<2){toast("Escolha 2 movimentos");return;}
  const pat=patamar(p.nivel); let log=[];
  REST.mv.forEach(id=>{
    if(id==="prep"){ p.esp=Math.min(p.esperancaMax,p.esp+2); log.push("Preparar-se: +2 Esperança"); }
    else if(id==="arm"){ const r=rnd(4)+pat; p.arm=Math.max(0,p.arm-r); log.push("Reparar Armadura 1d4+"+pat+" = "+r+" PA"); }
    else if(id==="fad"){ const r=rnd(4)+pat; p.fad=Math.max(0,p.fad-r); log.push("Reduzir Fadiga 1d4+"+pat+" = "+r+" PF"); }
    else if(id==="pv"){ const r=rnd(4)+pat; p.pv=Math.max(0,p.pv-r); log.push("Tratar Feridas 1d4+"+pat+" = "+r+" PV"); }
    else if(id==="armT"){ p.arm=0; log.push("Armadura totalmente reparada"); }
    else if(id==="pvT"){ p.pv=0; log.push("Todas as feridas tratadas"); }
    else if(id==="fadT"){ p.fad=0; log.push("Fadiga zerada"); }
    else if(id==="proj"){ log.push("Trabalhou em um projeto (anote o progresso)"); }
  });
  if(REST.tipo==="longo" && p.id==="lucius"){ const v=p.recursos.find(r=>/vampiro/i.test(r.nome)); if(v&&v.val>0){v.val--; log.push("Vampiro: −1 marcador");} }
  REST.log=(REST.tipo==="curto"?"DESCANSO CURTO — ":"DESCANSO LONGO — ")+log.join(" · ");
  REST.mv=[]; saveOne(p); render(); toast("Repouso aplicado");
}

/* ============ DADOS DE DUALIDADE ============ */
let DICE={atr:"Agilidade",exp:-1,mod:0,adv:0,last:null};
function rolar(p){
  const h=rnd(12), f=rnd(12);
  let mod=(p.atributos[DICE.atr]||0)+(DICE.mod||0);
  let det=["Esperança <b>"+h+"</b>","Medo <i>"+f+"</i>",DICE.atr+" "+sg(p.atributos[DICE.atr]||0)];
  if(DICE.exp>=0&&p.experiencias[DICE.exp]){ mod+=p.experiencias[DICE.exp].bonus; det.push("Exp. +"+p.experiencias[DICE.exp].bonus); }
  if(DICE.adv){ const d=rnd(6); mod+=DICE.adv*d; det.push((DICE.adv>0?"vantagem +":"desvantagem −")+d); }
  if(DICE.mod) det.push("mod "+sg(DICE.mod));
  const tot=h+f+mod;
  const tipo=h===f?"crit":(h>f?"hope":"fear");
  DICE.last={tot,tipo,det:det.join(" · ")};
  if(tipo==="hope"||tipo==="crit"){ p.esp=Math.min(p.esperancaMax,p.esp+1); }
  if(tipo==="crit"){ p.fad=Math.max(0,p.fad-1); }
  saveOne(p); render();
}


/* ===== LEITOR DE FICHA EM PDF (formato "Surto Selvagem · ficha de mesa") ===== */
function pdfItemsToLines(pages){
  // pages: [{w, items:[{s,x,y}]}]  -> returns {lines:[string], header:[items]}
  const lefts=[], rights=[], header=[];
  pages.forEach((pg,pi)=>{
    let yA=null;
    let yC=null;
    if(pi===0){ const a=pg.items.find(i=>/^ATRIBUTOS$/.test(i.s.replace(/\s/g,""))); if(a) yA=a.y; const c=pg.items.find(i=>/^CONCEITO$/.test(i.s.replace(/\s/g,""))); if(c) yC=c.y; }
    pg.items.forEach(it=>{
      if(pi===0 && yA!=null && (it.y>yA+2 || (yC!=null && it.y>yC+2 && it.x<pg.w*0.5))) header.push(it);
      else if(it.x<pg.w*0.5) lefts.push({...it,pg:pi});
      else rights.push({...it,pg:pi});
    });
  });
  function toLines(items){
    items.sort((a,b)=>a.pg-b.pg || b.y-a.y || a.x-b.x);
    const lines=[]; let curL=null, curY=null, curPg=null;
    items.forEach(it=>{
      if(curL && it.pg===curPg && Math.abs(it.y-curY)<3.5){ curL.push(it); }
      else { if(curL) lines.push(curL); curL=[it]; curY=it.y; curPg=it.pg; }
    });
    if(curL) lines.push(curL);
    return lines.map(joinItems).filter(Boolean);
  }
  return {lines:[...toLines(lefts),...toLines(rights)],header};
}
function joinItems(l){
  l.sort((a,b)=>a.x-b.x); let out="",prev=null;
  l.forEach(i=>{ const t=unspace(i.s); if(!t.trim()){ if(out&&!/\s$/.test(out)) out+=" "; prev=i;return;} if(prev && out && !/\s$/.test(out) && (i.x-(prev.x+(prev.w||0))>1.2 || /^[\s]/.test(i.s))) out+=" "; out+=t; prev=i; });
  return out.replace(/[\x00-\x1f]/g,"").replace(/\s+/g," ").trim();
}
function unspace(s){ // "V A L O R · T A L E N T O" -> "VALOR · TALENTO"
  const t=s.trim();
  if(/^\S( \S)+$/.test(t)) return t.replace(/ /g,"");
  return s;
}
function tcase(s){ const small=/^(de|da|do|das|dos|a|o|e|em|na|no|à|ao|para|com|por)$/; return s.toLowerCase().split(" ").map((w,i)=>(i>0&&small.test(w))?w:w.replace(/(^|[\-–(])(\p{L})/gu,(m,a,b)=>a+b.toUpperCase())).join(" "); }
function nearestBelow(header,label){
  const norm=t=>t.replace(/\s+/g,"").toUpperCase();
  const target=norm(label); let lab=null;
  const items=[...header].filter(i=>i.s.trim()).sort((a,b)=>b.y-a.y||a.x-b.x);
  for(let i=0;i<items.length&&!lab;i++){
    let acc="",x0=items[i].x,x1=items[i].x+(items[i].w||0);
    for(let j=i;j<items.length;j++){ if(Math.abs(items[j].y-items[i].y)>3) break; acc+=norm(items[j].s); x1=items[j].x+(items[j].w||0); if(acc===target){ lab={x:x0,w:x1-x0,y:items[i].y}; break; } if(acc.length>=target.length) break; }
  }
  if(!lab) return null;
  const cx=lab.x+(lab.w||0)/2;
  let best=null;
  header.forEach(i=>{ if(/^[+\-−–]?\d+$/.test(i.s.trim()) && i.y<lab.y-4 && lab.y-i.y<60){ const d=Math.abs((i.x+(i.w||0)/2)-cx); if(d<45 && (!best||d<best.d)) best={d,v:parseInt(i.s.replace(/[−–]/,"-"))}; } });
  return best?best.v:null;
}
function parseFichaPDF(pages, CARDS){
  const {lines,header}=pdfItemsToLines(pages);
  const L=lines.map(unspace);
  const p={id:"pdf_"+Date.now().toString(36),nome:"",classe:"",subclasse:"",conjuracao:"",nivel:1,dominios:[],conceito:"",evasao:10,pvMax:6,fadigaMax:6,prof:1,limMenor:7,limGrave:13,armaduraMax:3,esperancaMax:6,
    atributos:{"Força":0,"Agilidade":0,"Acuidade":0,"Instinto":0,"Presença":0,"Conhecimento":0},
    ancNome:"",ancFeats:[],comNome:"",comFeats:[],transNome:"",transFeats:[],armaPrim:"",armaSec:"Nenhuma",armadura:"",itens:"",habilidades:[],subFeats:[],cartas:[],experiencias:[],recursos:[],bolsa:[],notas:"",corrupcaoRegra:""};
  // --- cabeçalho (itens com posição) ---
  const stat=(lab)=>nearestBelow(header,lab);
  const S={evasao:stat("EVASÃO"),pvMax:stat("PV"),fadigaMax:stat("FADIGA"),prof:stat("PROFICIÊNCIA"),limMenor:stat("LIM. MENOR"),limGrave:stat("LIM. GRAVE")};
  Object.keys(S).forEach(k=>{ if(S[k]!=null) p[k]=S[k]; });
  ["Força","Agilidade","Acuidade","Instinto","Presença","Conhecimento"].forEach(a=>{ const v=stat(a.toUpperCase()); if(v!=null) p.atributos[a]=v; });
  const hl=pdfItemsToLines([{w:9999,items:header.map(i=>({...i,pg:0}))}]);
  // linhas do cabeçalho: título, nome, linha de classe
  const hlines=[]; { const items=[...header].sort((a,b)=>b.y-a.y||a.x-b.x); let cur=[],cy=null; items.forEach(i=>{ if(cur.length&&Math.abs(i.y-cy)<3.5)cur.push(i); else{ if(cur.length)hlines.push(cur); cur=[i];cy=i.y;} }); if(cur.length)hlines.push(cur); }
  const HL=hlines.map(joinItems).filter(Boolean);
  const all=[...HL,...L];
  for(const ln of all){ const m=ln.match(/^(.+?)\s*—\s*(.+?)\s*·\s*Nível\s*(\d+)\s*·\s*Domínios:\s*(.+?)\s*&\s*(.+)$/i); if(m){ p.classe=tcase(m[1]); p.subclasse=m[2].trim(); p.nivel=parseInt(m[3]); let d2=m[5].trim(); const ov=d2.match(/^(.*?)\s*Nível\s*(\d+)$/); if(ov){ d2=ov[1].trim(); p.nivel=parseInt(ov[2]); } p.dominios=[m[4].trim(),d2]; break; } }
  const ti=HL.findIndex(l=>/SURTOSELVAGEM/i.test(l.replace(/\s/g,"")));
  if(ti>=0 && HL[ti+1]){ const n=HL[ti+1].trim(); p.nome=(n===n.toUpperCase()&&/\p{L}/u.test(n)&&!/\d/.test(n))?tcase(n):n; }
  // --- corpo linear ---
  const K=l=>l.replace(/\s/g,"").toUpperCase();
  const HEADS={IDENTIDADE:"IDENTIDADE",ANCESTRALIDADE:"ANCESTRALIDADE",COMUNIDADE:"COMUNIDADE","SAÚDE&DANO":"SAÚDE & DANO","ARMAS&EQUIPAMENTO":"ARMAS & EQUIPAMENTO",HABILIDADESDECLASSE:"HABILIDADES DE CLASSE",ESPERANÇA:"ESPERANÇA",CARTASDEDOMÍNIO:"CARTAS DE DOMÍNIO",EXPERIÊNCIAS:"EXPERIÊNCIAS",CONCEITO:"CONCEITO"};
  const headOf=l=>{ const k=K(l); if(HEADS[k])return HEADS[k]; if(/^TRANSFORMAÇÃO/.test(k))return "TRANSFORMAÇÃO"; if(/^SUBCLASSE[—\-–]/.test(k))return "SUBCLASSE"; if(/^AVANÇOS/.test(k))return "AVANÇOS"; if(/^CORRUPÇÃODOSURTO/.test(k))return "CORRUPÇÃO"; return null; };
  const isHead=l=>!!headOf(l);
  const isFoot=l=>/Daggerheart \(Darrington Press\)/.test(l);
  const isJunk=l=>isFoot(l)||/^[\d\s·+–\-]+$/.test(l)||/^Nível \d+$/.test(l)||/^((DANO MENOR|DANO MAIOR|DANO GRAVE)\s*)+$|^(marque \d PV\s*)+$|^Limiares (=|por) .*|^\(metade .*/.test(l);
  const sec={}; let cur=null;
  const CARDH=/^(?:NV(\d+)·)?(.+?)·(TALENTO|FEITIÇO|GRIMÓRIO|GRIMOIRE|HABILIDADE)·RECORDAÇÃO(\d+)$/;
  L.forEach(l=>{ if(isJunk(l))return; if(CARDH.test(K(l))){ cur="CARTAS DE DOMÍNIO"; sec[cur]=sec[cur]||[]; } const h=headOf(l); if(h){ cur=h; sec[cur]=sec[cur]||[]; if(h==="SUBCLASSE") sec._sub=l.replace(/^SUBCLASSE\s*[—\-–]\s*/,"").trim(); if(h==="TRANSFORMAÇÃO") sec._transHead=l; return; } if(cur) sec[cur].push(l); });
  const feats=(arr)=>{ // "Nome:" seguido de texto
    const out=[]; let f=null;
    arr.forEach(l=>{ const m=l.match(/^([^:]{2,60}):\s*(.*)$/); if(m && /^\p{Lu}/u.test(m[1]) && !/\d/.test(m[1].slice(0,2))){ f={n:m[1].trim(),t:m[2].trim()}; out.push(f);} else if(f){ f.t=(f.t+" "+l).trim(); } });
    return out;
  };
  if(sec.CONCEITO) p.conceito=sec.CONCEITO.join(" ").replace(/^[“"]|[”"]$/g,"").trim();
  if(sec.ANCESTRALIDADE){ p.ancNome=sec.ANCESTRALIDADE[0]||""; p.ancFeats=feats(sec.ANCESTRALIDADE.slice(1)); }
  if(sec.COMUNIDADE){ p.comNome=sec.COMUNIDADE[0]||""; p.comFeats=feats(sec.COMUNIDADE.slice(1)); }
  if(sec["TRANSFORMAÇÃO"]){ p.transNome=(sec["TRANSFORMAÇÃO"][0]||"")+(sec._transHead&&/VOID/i.test(sec._transHead)?" (The Void)":""); p.transFeats=feats(sec["TRANSFORMAÇÃO"].slice(1)); }
  (sec["SAÚDE & DANO"]||[]).forEach(l=>{ const m=l.match(/Vida \((\S+)\) · Fadiga \((\d+)\) · Armadura \((\d+)\)/); if(m){ if(/^\d+$/.test(m[1]))p.pvMax=parseInt(m[1]); p.fadigaMax=parseInt(m[2]); p.armaduraMax=parseInt(m[3]); } });
  { const A=sec["ARMAS & EQUIPAMENTO"]||[]; let itens=[]; let mode=null;
    A.forEach(l=>{ let m;
      if((m=l.match(/^Principal:\s*(.+?)(?: —.*)?$/))){ p.armaPrim=m[1].trim(); mode=null; }
      else if((m=l.match(/^Secundária:\s*(.+?)(?: —.*)?$/))){ p.armaSec=m[1].trim(); mode=null; }
      else if((m=l.match(/^Armadura:\s*(.+?)(?: —.*)?$/))){ p.armadura=/^Sem armadura/i.test(m[1])?"Sem armadura (Armadura Corporal)":m[1].trim(); mode=null; }
      else if((m=l.match(/^Reserva:\s*(.+?)(?: —.*)?$/))){ p.armaRes=m[1].trim(); mode=null; }
      else if((m=l.match(/^Itens:\s*(.*)$/))){ itens.push(m[1]); mode="it"; }
      else if(mode==="it") itens[itens.length-1]+=" "+l;
      else if(/^"?\S/.test(l) && p.armaPrim && !p.armaSec) {} });
    p.itens=itens.join(" ").replace(/\s+/g," ").trim(); }
  { const H=sec["HABILIDADES DE CLASSE"]||[]; if(H.length){ const nm=H[0]; const rest=H.slice(1).join(" "); if(rest) p.habilidades.push({n:nm,t:rest}); else p.habilidades.push({n:"Habilidades de classe",t:nm}); } }
  { const E=sec["ESPERANÇA"]||[]; if(E.length) p.habilidades.push({n:E[0]+" (Esperança)",t:E.slice(1).join(" ")}); }
  { const Sb=sec.SUBCLASSE||[]; let grau=null,f=null;
    Sb.forEach(l=>{ let m; if((m=K(l).match(/^CONJURAÇÃO:(.+)$/))){ p.conjuracao=tcase(m[1]); return; }
      if(/^(FUNDAMENTAL|ESPECIALIZAÇÃO|MAESTRIA)$/.test(K(l))){ grau=tcase(K(l)); f=null; return; }
      if(grau && !f){ f={n:l+" ("+grau+")",t:""}; p.subFeats.push(f); return; }
      if(f) f.t=(f.t+" "+l).trim(); });
    if(sec._sub && !p.subclasse) p.subclasse=tcase(sec._sub); }
  { const C=sec["CARTAS DE DOMÍNIO"]||[]; let card=null,expect=false;
    C.forEach(l=>{ const m=K(l).match(/^(?:NV(\d+)·)?(.+?)·(TALENTO|FEITIÇO|GRIMÓRIO|GRIMOIRE|HABILIDADE)·RECORDAÇÃO(\d+)$/);
      if(m){ const dom=tcase(m[2]).replace("Meia-Noite","Meia-noite"); const tipo=tcase(m[3]).replace("Habilidade","Talento").replace("Grimoire","Grimório"); card={dom,tipo,rec:parseInt(m[4]),lvl:m[1]?parseInt(m[1]):null,n:"",t:"",mao:true}; p.cartas.push(card); expect=true; return; }
      if(card && expect){ card.n=tcase(l); expect=false; return; }
      if(card) card.t=(card.t+" "+l).trim(); });
    p.cartas.forEach(c=>{ const pool=(CARDS&&CARDS[c.dom])||[]; const ref=pool.find(x=>x.n.toLowerCase()===c.n.toLowerCase()); if(ref){ c.n=ref.n; if(c.lvl==null)c.lvl=ref.lvl; if(!c.t)c.t=ref.t; } if(c.lvl==null)c.lvl=1; }); }
  { (sec["EXPERIÊNCIAS"]||[]).forEach(l=>{ const m=l.match(/^(.+?)\s*\+\s*(\d+)$/); if(m) p.experiencias.push({nome:m[1].trim().replace(/\.$/,""),bonus:parseInt(m[2])}); }); }
  if(sec["AVANÇOS"]) p.notas="Avanços: "+sec["AVANÇOS"].join(" ");
  if(sec["CORRUPÇÃO"]) p.corrupcaoRegra=sec["CORRUPÇÃO"].join(" ");
  if(!p.armadura) p.armadura="Gibão";
  return p;
}


async function importarPDF(file){
  if(!window.pdfjsLib){ alert("Leitor de PDF não carregou (precisa de internet na primeira abertura)."); return; }
  toast("Lendo PDF…");
  const buf=await file.arrayBuffer();
  const doc=await pdfjsLib.getDocument({data:buf}).promise;
  const pages=[];
  for(let i=1;i<=doc.numPages;i++){ const pg=await doc.getPage(i); const vp=pg.getViewport({scale:1}); const tc=await pg.getTextContent();
    pages.push({w:vp.width,items:tc.items.filter(it=>it.str!=null).map(it=>({s:it.str,x:it.transform[4],y:it.transform[5],w:it.width}))}); }
  const p=parseFichaPDF(pages,CARDS);
  if(!p.nome){ alert("Não reconheci esse PDF como uma ficha 'Surto Selvagem · ficha de mesa'."); return; }
  const base=BASE.find(b=>b.id===PJ[cur].id);
  const same=PJ.findIndex(x=>(x.nome||"").toLowerCase()===p.nome.toLowerCase());
  const alvo = same>=0 ? same : cur;
  const msg = same>=0 ? "Encontrei a ficha de "+p.nome+". Substituir a aba existente?\n\n(Cancelar = criar uma nova aba)" : "Importar "+p.nome+" ("+p.classe+" nv "+p.nivel+").\n\nOK = substituir a aba atual ("+PJ[cur].nome+")\nCancelar = criar uma nova aba";
  const substituir=confirm(msg);
  if(substituir){ const old=PJ[alvo]; p.id=old.id; p.pv=0;p.fad=0;p.esp=old.esp??2;p.arm=0;p.corr=old.corr||0; p.bolsa=old.bolsa||[]; p.recursos=old.recursos||[]; normaliza(p); p.notas=[...(Array.isArray(old.notas)?old.notas:[]),...p.notas]; if(!p.corrupcaoRegra) p.corrupcaoRegra=old.corrupcaoRegra||""; PJ[alvo]=p; cur=alvo; }
  else { p.pv=0;p.fad=0;p.esp=2;p.arm=0;p.corr=0; if(!p.corrupcaoRegra) p.corrupcaoRegra=BASE[0].corrupcaoRegra; PJ.push(p); cur=PJ.length-1; }
  lsSet(KEY+"_cur",String(cur));
  saveAll(); render(); window.scrollTo({top:0}); toast("Ficha de "+p.nome+" importada");
}
/* ============ COMPONENTES ============ */
function pipRow(cls,n,val,onclick){
  const row=el("div","pips");
  for(let i=1;i<=n;i++){
    const p=el("div","pip "+cls+(i<=val?" on":""));
    p.title=i; p.onclick=()=>onclick(i===val?i-1:i);
    row.appendChild(p);
  }
  return row;
}
function tracker(titulo,cls,val,max,set,extra){
  const box=el("div","trk");
  const lb=el("div","lb"); lb.appendChild(el("b",null,titulo));
  lb.appendChild(el("span",null,(extra||"")+val+" / "+max));
  box.appendChild(lb);
  box.appendChild(pipRow(cls,max,val,v=>{set(v);ch();}));
  return box;
}
function numField(lbl,val,set,big){
  const d=el("div","st"+(big?" big":"")); d.appendChild(el("label",null,lbl));
