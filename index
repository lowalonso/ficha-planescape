  featList(c,"Ancestralidade — "+esc(p.ancNome),p.ancFeats);
  featList(c,"Comunidade — "+esc(p.comNome),p.comFeats);
  if(p.transNome||p.transFeats.length) featList(c,"Multiclasse — "+esc(p.transNome||"—"),p.transFeats,"trans");
  if(p.compNome||(p.compFeats&&p.compFeats.length)){ if(!p.compFeats)p.compFeats=[]; featList(c,"Companheiro animal — "+esc(p.compNome||"—"),p.compFeats,"trans"); }
  featList(c,"Habilidades de classe — "+esc(p.classe),p.habilidades);
  featList(c,"Subclasse — "+esc(p.subclasse),p.subFeats);
  R.appendChild(c);

  // ---------- NOTAS ----------
  c=el("div","card"); c.appendChild(el("h2",null,"Anotações de sessão <small>"+p.notas.length+" nota(s)</small>"));
  const bn=el("button","add","+ nova anotação"); bn.onclick=()=>{ p.notas.unshift({titulo:"",texto:"",data:new Date().toISOString().slice(0,10),_ed:true}); render(); }; c.appendChild(bn);
  p.notas.forEach((n,i)=>{
    const box=el("div","nota");
    if(n._ed){
      const tt=el("input","tx"); tt.placeholder="Título (ex.: Sessão 4 — a torre)"; tt.value=n.titulo||""; tt.oninput=()=>n.titulo=tt.value; box.appendChild(tt);
      const tx=el("textarea"); tx.placeholder="Promessas, dívidas planares, pistas dos dedos, o que Shemeska cobrou…"; tx.value=n.texto||""; tx.style.minHeight="110px"; tx.style.marginTop="6px"; tx.oninput=()=>n.texto=tx.value; box.appendChild(tx);
      const bts=el("div","bts");
      const ok=el("button","ok","✓ salvar"); ok.onclick=()=>{ if(!n.titulo.trim()) n.titulo="Anotação "+n.data; delete n._ed; ch(); toast("Anotação salva"); };
      const cn=el("button",null,"cancelar"); cn.onclick=()=>{ if(!n.titulo&&!n.texto){ p.notas.splice(i,1);} else delete n._ed; render(); };
      const rm=el("button","rm","✕ excluir"); rm.onclick=()=>{ if(confirm("Excluir esta anotação?")){ p.notas.splice(i,1); ch(); } };
      bts.appendChild(ok); bts.appendChild(cn); bts.appendChild(rm); box.appendChild(bts);
      if(!n.titulo&&!n.texto) setTimeout(()=>tt.focus(),0);
    } else {
      const hd=el("div","hd"); hd.appendChild(el("b",null,esc(n.titulo))); hd.appendChild(el("span",null,esc(n.data||""))); box.appendChild(hd);
      box.appendChild(el("p",null,esc(n.texto)));
      const bts=el("div","bts");
      const ed=el("button",null,"✎ editar"); ed.onclick=()=>{ n._ed=true; render(); };
      const rm=el("button","rm","✕ excluir"); rm.onclick=()=>{ if(confirm("Excluir \""+n.titulo+"\"?")){ p.notas.splice(i,1); ch(); } };
      bts.appendChild(ed); bts.appendChild(rm); box.appendChild(bts);
    }
    c.appendChild(box);
  });
  if(!p.notas.length) c.appendChild(el("div","hint","Nenhuma anotação ainda. Use <b>nova anotação</b> pra registrar pistas, contatos, dívidas e cicatrizes do Sigil — cada nota tem data e pode ser editada depois."));
  R.appendChild(c);

  // ---------- BACKUP ----------
  c=el("div","card"); c.appendChild(el("h2",null,"Backup & impressão"));
  const acts=el("div","acts");
  function baixar(obj,nome){ const b=new Blob([JSON.stringify(obj,null,1)],{type:"application/json"}); const a=document.createElement("a"); a.href=URL.createObjectURL(b); a.download=nome; a.click(); }
  const bj=el("button",null,"💾 Baixar esta ficha (JSON)"); bj.onclick=()=>baixar(limpo(p),"ficha-"+(p.nome||p.id).toLowerCase().replace(/[^a-z0-9]+/gi,"-")+".json"); acts.appendChild(bj);
  const bja=el("button","g","💾 Baixar todas"); bja.onclick=()=>baixar(PJ.map(limpo),"surto-selvagem-fichas.json"); acts.appendChild(bja);
  const bi=el("button","g","📂 Carregar JSON"); bi.onclick=()=>{
    const inp=document.createElement("input"); inp.type="file"; inp.accept=".json,application/json";
    inp.onchange=()=>{const f=inp.files[0]; if(!f)return; const r=new FileReader();
      r.onload=()=>{try{ let d=JSON.parse(r.result); if(!Array.isArray(d)) d=[d]; let n=0;
        d.forEach(x=>{ if(!x||typeof x!=="object"||!x.nome) return; normaliza(x); if(!x.id) x.id="pj_"+Math.random().toString(36).slice(2,8);
          let i=PJ.findIndex(q=>q.id===x.id); if(i<0) i=PJ.findIndex(q=>(q.nome||"").toLowerCase()===x.nome.toLowerCase());
          if(i>=0){ x.id=PJ[i].id; PJ[i]=x; } else PJ.push(x); n++; });
        saveAll(); toast(n+" ficha(s) carregada(s)"); render(); }catch(e){alert("Arquivo inválido");}};
      r.readAsText(f);}; inp.click();};
  acts.appendChild(bi);
  const bpdf=el("button",null,"📄 Importar ficha PDF"); bpdf.onclick=()=>{
    const inp=document.createElement("input"); inp.type="file"; inp.accept="application/pdf,.pdf";
    inp.onchange=()=>{const f=inp.files[0]; if(!f)return; importarPDF(f).catch(e=>{console.error(e);alert("Não consegui ler o PDF: "+e.message);});}; inp.click();};
  acts.appendChild(bpdf);
  if(!BASE.some(b=>b.id===p.id)){ const bdel=el("button","d","🗑 Remover esta ficha"); bdel.onclick=()=>{ if(confirm("Remover a ficha de "+p.nome+"? Isso não pode ser desfeito.")){ lsDel(KEY_FICHA(p.id)); dbRemove(p.id); PJ.splice(cur,1); cur=Math.max(0,cur-1); saveIndex(); render(); } }; acts.appendChild(bdel); }
  const bpr=el("button","g","🖨 Imprimir"); bpr.onclick=()=>window.print(); acts.appendChild(bpr);
  const br=el("button","d",window._resetArmado?"⚠ tocar de novo para confirmar":"↺ Restaurar esta ficha");
  br.onclick=()=>{
    if(!window._resetArmado){window._resetArmado=true;render();setTimeout(()=>{window._resetArmado=false;render();},4000);return;}
    window._resetArmado=false;
    const b=BASE.find(x=>x.id===p.id); if(b){ PJ[cur]=normaliza(JSON.parse(JSON.stringify(b))); }
    saveOne(PJ[cur]);toast("Ficha restaurada");render();};
  acts.appendChild(br);
  c.appendChild(acts);
  c.appendChild(el("div","hint","<b>Importar ficha PDF</b> lê os PDFs exportados no formato “Surto Selvagem · ficha de mesa”: nome, atributos, limiares, armas, ancestralidade, habilidades, cartas e experiências. Confira os números depois — anotações à mão ou sobrepostas no PDF podem confundir a leitura. Cada ficha é salva separadamente. Com o banco configurado (veja o topo do arquivo / README), as fichas ficam na nuvem e todos da mesa veem as mudanças ao vivo; sem banco, ficam só neste navegador. Ao subir no GitHub Pages, cada jogador abre a mesma página no próprio celular e o estado fica salvo no aparelho dele. Use <b>Baixar JSON</b> no fim da sessão como backup e <b>Carregar JSON</b> para migrar de aparelho."));
  R.appendChild(c);
}
render();
dbInit();
</script>
</body>
</html>
